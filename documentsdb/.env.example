# Appwrite DocumentsDB connection — copy to `.env` and fill in.
# Bun exposes these to the client bundle via import.meta.env / process.env at build time.

# Appwrite API endpoint (self-hosted or cloud)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Project ID from the Appwrite console
APPWRITE_PROJECT_ID=

# DocumentsDB database ID
APPWRITE_DATABASE_ID=

# Collection / table ID that stores the log documents
APPWRITE_TABLE_ID=events

# Server API key — used ONLY by scripts/setup-collection.js (never sent to the browser).
# Needs the "collections.write" (Databases write) scope.
APPWRITE_API_KEY=
